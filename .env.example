# GEODATA HUB — environment template.
#
# Copy this file to .env (or .env.local) and fill in real values for your
# deployment. NEVER commit the real .env to version control — it carries
# the NEXTAUTH_SECRET used to sign session JWTs.
#
# All variables are REQUIRED for a working deployment.

# --- Database ---
# SQLite (development): file:./db/custom.db
# PostgreSQL (production): postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
DATABASE_URL=file:./db/custom.db

# --- Authentication ---
# NextAuth.js v4 — a random string of at least 32 characters used to sign
# session JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHAR_SECRET

# The public URL of the deployment. Required for production (NextAuth
# validates against this for redirects). Omit for local dev (defaults to
# http://localhost:3000).
# NEXTAUTH_URL=https://your-deployment.example.com

# --- Optional: server-side rate limiting / logging ---
# (no built-in rate limiter ships with the app — front with Caddy/nginx
# for production rate limiting. See docs/22-m6-completion-report.md.)
